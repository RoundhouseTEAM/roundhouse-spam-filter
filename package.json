{
  "name": "@roundhouse/spam-filter",
  "version": "2.10.0",
  "description": "Shared contact-form spam filter, lead handler and lead form for Roundhouse client sites",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./lead": {
      "types": "./lead.d.ts",
      "default": "./lead.js"
    },
    "./validate": {
      "types": "./validate.d.ts",
      "default": "./validate.js"
    },
    "./env": {
      "types": "./env-check.d.ts",
      "default": "./env-check.js"
    },
    "./form": "./form.tsx",
    "./conversion": "./conversion.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "log-blocked.js",
    "validate.js",
    "validate.d.ts",
    "lead.js",
    "ratelimit.js",
    "apps-script.js",
    "lead.d.ts",
    "env-check.js",
    "env-check.d.ts",
    "form.tsx",
    "conversion.tsx"
  ],
  "scripts": {
    "test": "node test.js && node test-log-blocked.js && node test-apps-script.js && node test-validate.js && node test-lead.js"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "license": "UNLICENSED",
  "private": true
}
